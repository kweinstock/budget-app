{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budget-app",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "kweinstock.dev/budget-app/*", "zone_name": "kweinstock.dev" }
  ],
  "env": {
    "testing": {
      "name": "budget-app-testing",
      "routes": [
        { "pattern": "testing.kweinstock.dev/budget-app/*", "zone_name": "kweinstock.dev" }
      ]
    }
  }
}